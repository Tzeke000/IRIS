# sands — "Sands" (Tzeke000, 2026-10-30): futuristic LED cube floating over desert dunes. scene.env for lib/render/scene.sh
#   S=/data/projects/sands/wt-iris-sands/scripts/lyric_scenes            (worktree on branch sands-scene)
#   $S/lib/render/scene.sh $S/real/sands/scene.env build
#   $S/lib/render/scene.sh $S/real/sands/scene.env stills 300,700,1000,... 50 16
#   FULL RENDER ONLY WITH ZEKE'S OK:  $S/lib/render/scene.sh $S/real/sands/scene.env full
NAME=sands
OUT_DIR=/home/iris/IRIS/scratch/scenes/sands
BLEND=$OUT_DIR/sands_v1.blend
STILLS_DIR=$OUT_DIR/stills
AUDIO=/data/iris_assets/sands/song/Sands.wav
FPS=30
NF=5965
BUILD_SCRIPT=$SCENE_DIR/build_scene.py
BUILD_ARGS="--out $BLEND --report $OUT_DIR/build_report.json --map $OUT_DIR/analysis/song_map.json --samples 24"
CAM_PREFIX=CAM_
WORKERS=2
CHUNK=60
VERIFY_ARGS="--ignore SunDisc,Arcs,Strikes"
