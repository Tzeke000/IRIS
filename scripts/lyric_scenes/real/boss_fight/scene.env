# boss_fight — scene.env for lib/render/scene.sh (sourced; SCENE_DIR + REPO preset; ALL PATHS ABSOLUTE)
#   scripts/lyric_scenes/lib/render/scene.sh $PWD/scripts/lyric_scenes/real/boss_fight/scene.env stills k_town,m_grass
# BUILD_SCRIPT deliberately unset: the arena is layered v1 → v2 → v3 by render.sh build/build2/build3 (scene.sh build refuses).
# CAM_PROPS = render_stills.py's EXPO dict + its "SIZE_PROOF only in d_* plan views" rule, as data. The d_*/e_pillar/f_roof
# reveal hacks are NOT ported — those stills stay on render_stills.py until a stills_hook.py exists.
NAME=bossfight
OUT_DIR=$REPO/scratch/scenes/boss_fight
BLEND=$OUT_DIR/arena_v3.blend
STILLS_DIR=$OUT_DIR/stills_lib
CAM_PREFIX=CAM_
CAM_PROPS='{
 "a_compound":    {"exposure_offset": 0.9,  "hide_collections": ["SIZE_PROOF"]},
 "a_compound_se": {"exposure_offset": 0.9,  "hide_collections": ["SIZE_PROOF"]},
 "b_colossi":     {"exposure_offset": 0.35, "hide_collections": ["SIZE_PROOF"]},
 "f_colossus":    {"exposure_offset": 0.25, "hide_collections": ["SIZE_PROOF"]},
 "c_hall":        {"exposure_offset": 0.3,  "hide_collections": ["SIZE_PROOF"]},
 "h_aisle":       {"exposure_offset": 0.4,  "hide_collections": ["SIZE_PROOF"]},
 "i_cover":       {"exposure_offset": 0.5,  "hide_collections": ["SIZE_PROOF"]},
 "j_cover_run":   {"exposure_offset": 0.5,  "hide_collections": ["SIZE_PROOF"]},
 "e_hoard":       {"exposure_offset": 0.3,  "hide_collections": ["SIZE_PROOF"]},
 "k_town":        {"exposure_offset": 0.6,  "hide_collections": ["SIZE_PROOF"]},
 "l_valley":      {"exposure_offset": 0.6,  "hide_collections": ["SIZE_PROOF"]},
 "m_grass":       {"exposure_offset": 0.6,  "hide_collections": ["SIZE_PROOF"]}
}'
# song pending from Zeke → set AUDIO + NF (and FPS) when it lands
