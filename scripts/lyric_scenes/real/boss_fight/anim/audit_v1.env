# STRICT audit of the saved v1 blend (no rendering, no save):  scene.sh $PWD/.../anim/audit_v1.env build
NAME=bossaudit1
OUT_DIR=$REPO/scratch/scenes/boss_fight
BLEND=$REPO/scratch/scenes/boss_fight/fight_v1.blend
BUILD_FROM=$REPO/scratch/scenes/boss_fight/fight_v1.blend
BUILD_SCRIPT=$SCENE_DIR/audit_strict.py
BUILD_ARGS="--v1-report $REPO/scratch/scenes/boss_fight/fight_v1_build_report.json --choreo $REPO/scripts/lyric_scenes/real/boss_fight/choreo_v1.json --out $REPO/scratch/scenes/boss_fight/audit_v1_strict.json --step ${AUDIT_STEP:-2} --from ${AUDIT_FROM:-1} --to ${AUDIT_TO:-0}"
