# STRICT audit of the saved v2 blend (no rendering, no save):  scene.sh $PWD/.../anim/audit_v2.env build
NAME=bossaudit2
OUT_DIR=$REPO/scratch/scenes/boss_fight
BLEND=$REPO/scratch/scenes/boss_fight/fight_v2.blend
BUILD_FROM=$REPO/scratch/scenes/boss_fight/fight_v2.blend
BUILD_SCRIPT=$SCENE_DIR/audit_strict.py
BUILD_ARGS="--meta $REPO/scratch/scenes/boss_fight/fight_v2_meta.json --out $REPO/scratch/scenes/boss_fight/audit_v2_strict.json --step 1"
