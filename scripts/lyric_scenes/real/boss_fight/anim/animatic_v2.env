# boss_fight ANIMATIC v2 — scene.env for lib/render/scene.sh (sourced; SCENE_DIR + REPO preset; ALL PATHS ABSOLUTE)
#   build (≈25–35 min, no rendering):   scripts/lyric_scenes/lib/render/scene.sh $PWD/scripts/lyric_scenes/real/boss_fight/anim/animatic.env build
#   animatic (renders! only with Iris's go):  scripts/lyric_scenes/real/boss_fight/anim/animatic.sh
# Low-res blocking render: 640x360 WORKBENCH clay (characters tinted, FX in their glow colours); frames →
# $OUT_DIR/frames, muxed with the song → animatic_v2.mp4 (MP4 below).
NAME=bossanim2
OUT_DIR=$REPO/scratch/scenes/boss_fight/animatic_v2
BLEND=$REPO/scratch/scenes/boss_fight/fight_v2.blend
BUILD_FROM=$REPO/scratch/scenes/boss_fight/arena_v3.blend
BUILD_SCRIPT=$SCENE_DIR/build_anim.py
BUILD_ARGS="--out $BLEND --audit-soft"
AUDIO=/data/iris_assets/dragon_slayer/dragon_slayer.wav
NF=7628
FPS=30
MP4=$REPO/scratch/scenes/boss_fight/animatic_v2.mp4
STILLS_DIR=$OUT_DIR/stills
GRAIN=0
CRF=23
CHUNK=60
WORKERS=2
SPP=4
PATCH='{
 "render": {"engine": "BLENDER_WORKBENCH", "resolution_x": 640, "resolution_y": 360, "resolution_percentage": 100,
            "use_motion_blur": false, "use_compositing": false},
 "set": {"scene.display.shading.show_cavity": false, "scene.display.shading.show_shadows": false,
         "scene.display.render_aa": "OFF"},
 "hide_collections": ["FX_haze", "V3_EXT_FOG", "SIZE_PROOF", "ANIM_PROXIES"]
}'
# measured 10-16 on fight_v1 (qa/time_ab, 4 shots, warm): workbench 0.75-0.98 s/frame; EEVEE 4 spp no-RT/vol 3.98-5.01 s
# (no shadows 3.6-3.7; +no grass/woods 3.1-3.5). EEVEE look-dev variant:
#   PATCH='{"render": {"resolution_x": 640, "resolution_y": 360, "use_motion_blur": false, "use_compositing": false},
#           "eevee": {"use_raytracing": false, "volumetric_tile_size": "16"}, "hide_collections": ["FX_haze", "V3_EXT_FOG", "SIZE_PROOF", "ANIM_PROXIES"]}'

