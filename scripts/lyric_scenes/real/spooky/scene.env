# spooky — "Spooky v2": the video lives INSIDE the song's cover art. scene.env for lib/render/scene.sh
#   scripts/lyric_scenes/lib/render/scene.sh $PWD/scripts/lyric_scenes/real/spooky/scene.env build
#   scripts/lyric_scenes/lib/render/scene.sh $PWD/scripts/lyric_scenes/real/spooky/scene.env stills a_hero,b_moon 50 16
# Look-dev round (v1): world + look + ghost motion + stills. No shot plan / camera bake until the drop times are confirmed by ear.
NAME=spooky
OUT_DIR=$REPO/scratch/scenes/spooky
BLEND=$OUT_DIR/spooky_v1.blend
STILLS_DIR=$OUT_DIR/stills
AUDIO=/data/iris_assets/spooky_futurebass/spooky_futurebass.wav
FPS=30
NF=7632
BUILD_SCRIPT=$SCENE_DIR/build.py
BUILD_ARGS="--out $BLEND --report $OUT_DIR/build_report.json --samples 32"
CAM_PREFIX=CAM_
STILL_AT=295
VERIFY_ARGS="--ignore HazeBox,Mist_,Cloud_,MoonHalo,Petals,Fireflies,ShootingStars,Water"
