# spooky — "Spooky v2": the video lives INSIDE the song's cover art. scene.env for lib/render/scene.sh
#   scripts/lyric_scenes/lib/render/scene.sh $PWD/scripts/lyric_scenes/real/spooky/scene.env build
#   scripts/lyric_scenes/lib/render/scene.sh $PWD/scripts/lyric_scenes/real/spooky/scene.env stills 1921,5761 50 16
# v2 (10-19, Zeke): ONE living picture of the cover that reacts to the music — one fixed camera (CAM_live, bass shake
# baked), no shot list. Stills = frames of that camera:  scene.sh ENV stills 900,1950,3000,5300,6740,7400 50 16
# Preview (no full render without Zeke's OK): OUT_DIR=$REPO/scratch/scenes/spooky/v2/preview PCT=50 scene.sh ENV par 1681 2280
NAME=spooky
OUT_DIR=$REPO/scratch/scenes/spooky
BLEND=$OUT_DIR/spooky_v2.blend
STILLS_DIR=$OUT_DIR/v2/stills
AUDIO=/data/iris_assets/spooky_futurebass/spooky_futurebass.wav
FPS=30
NF=7632
BUILD_SCRIPT=$SCENE_DIR/build.py
BUILD_ARGS="--out $BLEND --report $OUT_DIR/build_report.json --samples 32"
CAM_PREFIX=CAM_
STILL_AT=1921
VERIFY_ARGS="--ignore HazeBox,Mist_,Cloud,MoonHalo,Petals,Fireflies,ShootingStars,Water --frames 1921,5761"
