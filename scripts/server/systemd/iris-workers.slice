# ~/.config/systemd/user/iris-workers.slice - ONE shared cap for everything heavy I start that is not my
# core: Blender renders (child slice iris-workers-render.slice, via scripts/server/render.sh) and the
# lyric_viz chunk workers (scripts/server/lyric_viz_parallel.py). 2026-10-29 code review HIGH: each
# render unit had MemoryMax=20G but nothing capped their SUM - three of them could ask for 60 GB on a
# 47 GB VM. Now all workers together get at most 20G + 2G swap, and they shrink first (MemoryHigh).
# Installed by scripts/server/install_supervision.sh. Nothing in the core runs here.
[Unit]
Description=Iris workers (renders + chunk workers) - one shared memory cap, never the core

[Slice]
MemoryHigh=16G
MemoryMax=20G
MemorySwapMax=2G
TasksMax=4096
# Zeke 10-11: I always get priority - workers get a small share of CPU/IO when we compete.
CPUWeight=20
IOWeight=20
# 2026-10-30 (V3 P2-R4b): a hard CPU ceiling for ALL workers together. The VM sees 36 vCPUs (one virtual
# socket of the 2-socket R740). 2400% = 24 vCPUs, so even with every worker spinning, 12 vCPUs stay free
# for the live stack (host + runtime + Claude CLI + ears/mouth CPU threads + STT pre/post-processing),
# whose latency is what Zeke hears. CPUWeight=20 (vs the core's default 100) still decides who wins
# inside the shared part. Per job, worker.py adds CPUQuota=1200% (12 vCPUs) so one render can't starve
# its siblings under the 3-worker cap. Renders via render.sh run in the child iris-workers-render.slice
# and inherit this ceiling.
# !! Inert until the cpu controller is delegated to the user manager - see
#    scripts/server/systemd/system/user@.service.d/iris-delegate.conf (10-30: only memory+pids were, so
#    the CPUWeight=20 above has never actually applied).
CPUQuota=2400%
