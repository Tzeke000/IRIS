# iris-integrity - find damaged lines (NUL torn writes, unparseable JSONL) in my memory + state files.
# Zeke 11-01: "make a checker that you run a bit after your restart". Read-only; report -> state/health/integrity.json.
[Unit]
Description=Iris state/memory integrity check

[Service]
Type=oneshot
WorkingDirectory=%h/IRIS
ExecStart=%h/venvs/iris-v100/bin/python %h/IRIS/scripts/server/state_integrity.py
SuccessExitStatus=1
TimeoutStartSec=120
Nice=10
